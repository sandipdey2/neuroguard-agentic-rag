# Copy to .env and fill in. NEVER commit .env. Placeholders only.
OPENAI_API_KEY=PASTE_YOUR_KEY_HERE
OPENAI_API_BASE=https://openai.vocareum.com/v1
NG_API_KEY=PASTE_A_LONG_RANDOM_API_KEY_HERE
NG_RECEIPT_KEY=PASTE_A_LONG_RANDOM_RECEIPT_KEY_HERE
NG_WEBHOOK_SECRET=PASTE_A_LONG_RANDOM_WEBHOOK_SECRET_HERE
NG_CORS_ORIGINS=https://your-web-app.example
# Optional backends (SQLite is the default; leave unset to keep it):
# DATABASE_URL=postgresql://USER:PASTE_A_DB_PASSWORD_HERE@localhost:5432/neuroguard
# REDIS_URL=redis://localhost:6379/0
# NG_QUEUE_URL=redis://localhost:6379/1

# Optional Arize Phoenix tracing (off by default; leave unset on Streamlit Cloud):
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# NG_PHOENIX=1

# Optional Arize AX (cloud) export (off by default until both are set):
# ARIZE_SPACE_ID=PASTE_YOUR_SPACE_ID_HERE
# ARIZE_API_KEY=PASTE_YOUR_ARIZE_API_KEY_HERE
