{
  "contract_version": "1.2.0",
  "description": "Run contract fixed before the first LLM token. Loaded and SHA-256 hashed at the start of every run; the hash is written into the signed receipt.",
  "model": "gpt-4o-mini",
  "temperature": 0,
  "llm_timeout_s": 60,
  "loop": {
    "max_orchestrator_turns": 9,
    "max_visits_per_agent": 2,
    "max_tool_rounds_per_agent": 4,
    "max_revisions": 1,
    "max_retrieval_rounds": 2,
    "max_self_revisions": 1,
    "planner": true
  },
  "budget": {
    "max_llm_calls": 36,
    "max_tool_calls": 32,
    "max_total_tokens": 110000,
    "wall_clock_timeout_s": 300
  },
  "agents": {
    "orchestrator": {
      "tools": [],
      "resources": [],
      "prompts": []
    },
    "planner": {
      "tools": [
        "episode_recall"
      ],
      "resources": [],
      "prompts": []
    },
    "intake": {
      "tools": [
        "screen_note",
        "memory_read"
      ],
      "resources": [],
      "prompts": []
    },
    "risk_analyst": {
      "tools": [
        "predict_risk",
        "explain_factors",
        "cohort_stats",
        "calculator"
      ],
      "resources": [
        "model://risk-card"
      ],
      "prompts": []
    },
    "evidence_researcher": {
      "tools": [
        "search_guidelines",
        "graph_traverse"
      ],
      "resources": [
        "guideline://{id}",
        "graph://knowledge-graph"
      ],
      "prompts": []
    },
    "clinical_writer": {
      "tools": [],
      "resources": [],
      "prompts": [
        "clinical_report"
      ]
    },
    "safety_reviewer": {
      "tools": [],
      "resources": [],
      "prompts": [
        "red_team_review"
      ]
    },
    "harness": {
      "tools": [
        "memory_write",
        "episode_write"
      ],
      "resources": [
        "model://risk-card"
      ],
      "prompts": []
    },
    "classical_retriever": {
      "tools": [
        "semantic_search"
      ],
      "resources": [
        "guideline://{id}"
      ],
      "prompts": []
    }
  },
  "write_tools": {
    "memory_write": "requires_user_consent",
    "episode_write": "harness_only_deidentified"
  },
  "tool_arg_limits": {
    "calculator.expression_max_chars": 120,
    "search_guidelines.k_max": 5,
    "memory_read.limit_max": 5,
    "graph_traverse.max_hops_max": 3,
    "graph_traverse.k_max": 8,
    "episode_recall.k_max": 3,
    "semantic_search.k_max": 5,
    "search_files.max_results_max": 10,
    "web_search.k_max": 3,
    "web_calls_max_per_run": 3,
    "shell_calls_max_per_run": 4,
    "shell.command_max_chars": 200,
    "execute_query.sql_max_chars": 600
  },
  "required_checks": [
    "risk_in_unit_interval",
    "risk_matches_model",
    "report_states_model_risk",
    "every_evidence_claim_cited",
    "citations_were_retrieved",
    "numbers_grounded",
    "no_dosing_advice",
    "no_diagnosis_claim",
    "disclaimer_present",
    "no_phi_in_output",
    "red_team_pass",
    "within_budget"
  ],
  "human_approval": {
    "required_when": [
      "risk_band == high",
      "note_has_red_flag_signs",
      "reviewer_approved_with_warnings",
      "confidence < confidence.review_below"
    ],
    "effect": "report is finalized as a draft that a clinician must approve or reject in the UI; the decision is added to a re-signed receipt"
  },
  "receipt": {
    "algorithm": "HMAC-SHA256",
    "key_source": "NG_RECEIPT_KEY secret (ephemeral per-process key if unset)"
  },
  "context": {
    "model_context_window": 128000,
    "tokenizer": "tiktoken o200k_base",
    "max_tool_output_tokens": 1500,
    "writer_evidence_tokens": 3500,
    "agent_context_tokens": 12000
  },
  "confidence": {
    "weights": {
      "calibration": 0.15,
      "cohort": 0.1,
      "coverage": 0.25,
      "verifier": 0.3,
      "red_team": 0.1,
      "grounding": 0.1
    },
    "refuse_below": 0.4,
    "review_below": 0.7,
    "note": "heuristic evidence-quality score, not a probability of correctness"
  },
  "pricing": {
    "model": "gpt-4o-mini",
    "input_per_1m": 0.15,
    "output_per_1m": 0.6,
    "cached_input_per_1m": 0.075,
    "source": "https://platform.openai.com/docs/pricing (Standard tier, gpt-4o-mini)",
    "accessed": "2026-11-13",
    "note": "list price; the Vocareum course gateway may bill differently"
  },
  "learning": {
    "enabled": true,
    "window": 30,
    "min_support": 2,
    "max_hints": 3,
    "retrieval_boost_step": 0.01,
    "retrieval_boost_cap": 0.06,
    "scope": "whitelisted hint texts + bounded retrieval boosts only; no code, prompt-file, contract or model changes; reset in UI"
  },
  "episodic_memory": {
    "store": "every LLM run, de-identified (age band, factor names, route, verdicts, outcome); no free text",
    "recall_k": 3
  },
  "batch": {
    "max_concurrency": 3,
    "llm_calls_per_minute": 120,
    "max_cases": 6
  },
  "rag_modes": {
    "default": "agentic",
    "classical": {
      "description": "fixed retrieval pipeline: the harness calls semantic_search once per required topic BEFORE the LLM; the docs are injected into the context window (system prompt + user message + docs); the LLM makes no tool calls",
      "retriever_agent": "classical_retriever",
      "k_per_query": 2,
      "max_docs": 8
    },
    "agentic": {
      "description": "the LLM issues search tool calls itself (ReAct); context window = system prompt + skills front matter + tool list + memory file + history + user message + tool calls + tool results",
      "evidence_researcher_tools": [
        "search_guidelines",
        "graph_traverse"
      ]
    },
    "agentic_search": {
      "description": "agentic search in context engineering: MCP context-retrieval tools over local files, database, web and long-term memory",
      "evidence_researcher_tools": [
        "semantic_search",
        "graph_traverse",
        "search_files",
        "load_skill",
        "execute_query",
        "web_search",
        "web_fetch",
        "get_memory",
        "shell"
      ],
      "max_tool_rounds_per_agent": 6,
      "required_sources": {
        "local_files": [
          "search_files",
          "shell"
        ],
        "memory": [
          "get_memory"
        ],
        "database": [
          "semantic_search",
          "execute_query"
        ],
        "web": [
          "web_search",
          "web_fetch"
        ]
      }
    }
  },
  "high_risk_tools": {
    "shell": "argv allowlist grep/wc/head/ls, no metacharacters, no absolute/parent paths, cwd knowledge/, empty env, 3 s timeout (hook + server)",
    "web_fetch": "https + host allowlist cdc.gov/nih.gov/who.int, no IP literals/ports/credentials, redirects re-checked, private DNS answers refused (hook + server)",
    "web_search": "allowlisted source pages only; local excerpt always returned (offline-safe)",
    "execute_query": "single SELECT/WITH, read-only connection + authorizer, 50 rows, 2 s (hook + server)"
  }
}