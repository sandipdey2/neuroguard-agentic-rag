# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > App settings > Secrets.
OPENAI_API_KEY = "PASTE_YOUR_KEY_HERE"
OPENAI_API_BASE = "https://openai.vocareum.com/v1"
# Optional: a long random string so signed receipts stay verifiable across restarts.
NG_RECEIPT_KEY = "PASTE_A_LONG_RANDOM_STRING"

# Optional: leave unset on Streamlit Cloud. Local Phoenix only.
# PHOENIX_COLLECTOR_ENDPOINT = "http://localhost:6006"

# Optional Arize AX (cloud). Paste your values; never commit real keys.
# App settings > Secrets on Streamlit Community Cloud, then reboot the app.
ARIZE_SPACE_ID = "PASTE_YOUR_SPACE_ID_HERE"
ARIZE_API_KEY = "PASTE_YOUR_ARIZE_API_KEY_HERE"
